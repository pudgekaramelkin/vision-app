@@ -0,0 +1,7 @@
+import Database from 'better-sqlite3';
+const output = process.argv[2];
+if (!output) throw new Error('Usage: node scripts/backup.mjs <backup-path>');
+const db = new Database(process.env.DATABASE_PATH || 'data/vision.db', { fileMustExist: true });
+await db.backup(output);
+db.close();
+console.log('Consistent SQLite backup completed. Keep backups outside the service volume.');
diff --git a/scripts/build-sites.mjs b/scripts/build-sites.mjs
new file mode 100644
index 0000000..d0c91e3
--- /dev/null
+++ b/scripts/build-sites.mjs
@@ -0,0 +1,39 @@
+import { spawnSync } from 'node:child_process';
+import { mkdir, cp, rm, readdir, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+const run = (args, env = {}) => {
+	const r = spawnSync(process.execPath, args, {
+		stdio: 'inherit',
+		env: { ...process.env, ...env }
+	});
+	if (r.status !== 0) process.exit(r.status || 1);
+};
+await rm('dist', { recursive: true, force: true });
+run(['node_modules/vite/bin/vite.js', 'build'], { BUILD_TARGET: 'sites' });
+await mkdir('dist/client', { recursive: true });
+for (const entry of await readdir('.svelte-kit/cloudflare')) {
+	if (['_worker.js', '_routes.json', '_headers', '_redirects'].includes(entry)) continue;
+	await cp(resolve('.svelte-kit/cloudflare', entry), resolve('dist/client', entry), {
+		recursive: true
+	});
+}
+run(['node_modules/wrangler/bin/wrangler.js', 'deploy', 'hosting/worker.ts', '--dry-run', '--outdir', 'dist/server']);
+await cp('dist/server/worker.js', 'dist/server/index.js');
+await rm('dist/server/worker.js');
+await writeFile(
+	'dist/server/wrangler.json',
+	JSON.stringify({
+		main: 'index.js',
+		compatibility_date: '2026-05-15',
+		compatibility_flags: ['nodejs_compat'],
+		assets: { directory: '../client', binding: 'ASSETS' },
+		d1_databases: [
+			{
+				binding: 'DB',
+				database_name: 'vision-local',
+				database_id: '00000000-0000-4000-8000-000000000000',
+				migrations_dir: '../../drizzle'
+			}
+		]
+	})
+);
diff --git a/scripts/promote-admin.mjs b/scripts/promote-admin.mjs
new file mode 100644
index 0000000..8db032f
--- /dev/null
+++ b/scripts/promote-admin.mjs
@@ -0,0 +1,8 @@
+import Database from 'better-sqlite3';
+const username = process.argv[2];
+if (!username) throw new Error('Usage: node scripts/promote-admin.mjs <registered-username>');
+const db = new Database(process.env.DATABASE_PATH || 'data/vision.db', { fileMustExist: true });
+const result = db.prepare("UPDATE users SET role = 'admin' WHERE username = ?").run(username);
+if (result.changes !== 1) throw new Error('Registered user not found');
+console.log('Administrator role assigned.');
+db.close();
